set configs.config.server-config.jms-service.type=LOCAL

delete-auth-realm certificate
create-auth-realm --classname com.sun.enterprise.security.auth.realm.certificate.CertificateRealm --property assign-groups=unitadmins:common-name-as-principal-name=true certificate

set configs.config.server-config.network-config.protocols.protocol.http-listener-1.http.comet-support-enabled=true
#
#set configs.config.server-config.network-config.protocols.protocol.http-listener-2.http.encoded-slash-enabled=true
set configs.config.server-config.network-config.protocols.protocol.http-listener-2.ssl.client-auth-enabled=true
#set configs.config.server-config.network-config.protocols.protocol.http-listener-2.ssl.client-auth=need

#Alle SSL Einstellungen in das post-boot-command migriert
#set configs.config.server-config.network-config.protocols.protocol.http-listener-2.ssl.key-store=${ENV=SECRETS_DIR}/keystore.jks
#set configs.config.server-config.network-config.protocols.protocol.http-listener-2.ssl.trust-store=${ENV=SECRETS_DIR}/cacerts.jks
#Overridden in post-boot-commands.asadmin
#set configs.config.server-config.network-config.protocols.protocol.http-listener-2.ssl.cert-nickname=${ENV=SPHAIRAS_PROVIDER}

#create-jvm-options '-Dcom.sun.enterprise.security.httpsOutboundKeyAlias=s1as
#create-system-properties com.sun.enterprise.security.httpsOutboundKeyAlias=s1as
#Payara Enterprise only?
#add-to-keystore --file ${ENV=SECRETS_DIR}/keystore.jks ${ENV=CERT_ALIAS}
#Set in post-boot-command?
#create-system-properties javax.net.ssl.keyStore=${ENV=SECRETS_DIR}/keystore.jks
#create-system-properties javax.net.ssl.trustStore=${ENV=SECRETS_DIR}/cacerts.jks
#create-system-properties com.sun.enterprise.security.httpsOutboundKeyAlias=${ENV=CERT_ALIAS}
#create-jvm-option -- -Djavax.net.ssl.keyStore=${ENV=SECRETS_DIR}/keystore.jks
#create-jvm-option -- -Djavax.net.ssl.trustStors=${ENV=SECRETS_DIR}/cacerts.jks
#create-jvm-option -- -Dcom.sun.enterprise.security.httpsOutboundKeyAlias=${ENV=CERT_ALIAS}

set configs.config.server-config.network-config.protocols.protocol.http-listener-1.http.encoded-slash-enabled=true
set configs.config.server-config.network-config.protocols.protocol.http-listener-1.http.websockets-support-enabled=true

#create-jvm-option -- -Djavax.net.debug=all #Muss ins Dockerfile als Environment-Variable
#set-log-levels com.sun.enterprise.security.ssl=FINEST:org.glassfish.grizzly.ssl=FINEST:javax.net.ssl=FINEST
set-log-levels javax.net.ssl=FINEST