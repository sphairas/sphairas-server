<?xml version="1.0" encoding="UTF-8"?>
<web-app 
    xmlns="https://jakarta.ee/xml/ns/jakartaee" 
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
    xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
    version="6.0" >
    <!--    jakarta.faces.PROJECT_STAGE
    Controls JSF's operational mode and affects debugging, error handling, and performance optimizations.
    Values:

    Development - Detailed error messages, no caching, debugging enabled
    Production - Minimal error messages, aggressive caching, optimized performance
    SystemTest - For integration testing
    UnitTest - For unit testing-->
    <context-param>
        <param-name>jakarta.faces.PROJECT_STAGE</param-name>
        <param-value>${jsf.projectStage}</param-value>
    </context-param>
    <context-param>
        <param-name>jakarta.faces.FACELETS_REFRESH_PERIOD</param-name>
        <param-value>${jsf.faceletsRefreshPeriod}</param-value>
    </context-param>
    <context-param>
        <param-name>primefaces.THEME</param-name>
        <param-value>saga</param-value>
    </context-param>
    <context-param>
        <param-name>primefaces.SUBMIT</param-name>
        <param-value>partial</param-value>
    </context-param>
    <context-param>
        <param-name>primefaces.CLIENT_SIDE_VALIDATION</param-name>
        <param-value>true</param-value>
    </context-param>
    <!-- Other useful JSF parameters you might want to add: -->
    <!-- Disable deprecated features -->
    <context-param>
        <param-name>jakarta.faces.INTERPRET_EMPTY_STRING_SUBMITTED_VALUES_AS_NULL</param-name>
        <param-value>true</param-value>
    </context-param>
    <!-- Better error handling in development -->
    <context-param>
        <param-name>jakarta.faces.FACELETS_SKIP_COMMENTS</param-name>
        <param-value>true</param-value>
    </context-param>
    <!-- View state configuration -->
    <context-param>
        <param-name>jakarta.faces.STATE_SAVING_METHOD</param-name>
        <param-value>server</param-value> <!-- or 'client' for stateless -->
    </context-param>
    <!-- Useful for debugging -->
    <context-param>
        <param-name>primefaces.FONT_AWESOME</param-name>
        <param-value>false</param-value> <!-- Using PrimeIcons instead -->
    </context-param><!-- Enable GZIP compression for resources -->
    <context-param>
        <param-name>primefaces.GZIP</param-name>
        <param-value>true</param-value>
    </context-param>
    <!-- Cache resources for better performance -->
    <context-param>
        <param-name>primefaces.CACHE_PROVIDER</param-name>
        <param-value>org.primefaces.cache.DefaultCacheProvider</param-value>
    </context-param>
    <servlet>
        <servlet-name>FacesServlet</servlet-name>
        <servlet-class>jakarta.faces.webapp.FacesServlet</servlet-class>
        <!--Evtl. anpassen für Performance-->
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet>
        <servlet-name>ZeugnisServlet</servlet-name>
        <servlet-class>org.thespheres.betula.web.docsrv.ZeugnisServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>webdav</servlet-name>
        <servlet-class>org.thespheres.betula.web.config.AppResourcesServlet</servlet-class>
        <init-param>
            <param-name>debug</param-name>
            <param-value>0</param-value>
        </init-param>
        <init-param>
            <param-name>listings</param-name>
            <param-value>true</param-value>
        </init-param>
        <init-param>
            <param-name>readonly</param-name>
            <param-value>false</param-value>
        </init-param>
    </servlet>
    <servlet-mapping>
        <servlet-name>FacesServlet</servlet-name>
        <url-pattern>/ui/*</url-pattern>
        <!-- ADD THIS: Map JSF servlet to handle error pages -->
        <url-pattern>*.xhtml</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ZeugnisServlet</servlet-name>
        <url-pattern>/zgnsrv/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>webdav</servlet-name>
        <url-pattern>/dav/*</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>${session.timeoutMinutes}</session-timeout>
    </session-config>
    <welcome-file-list>
        <welcome-file>index.xhtml</welcome-file>
    </welcome-file-list>
    <security-constraint>
        <display-name>Secure all paths</display-name>
        <web-resource-collection>
            <web-resource-name>Restricted</web-resource-name>
            <url-pattern>/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>signee</role-name>
            <role-name>unitadmin</role-name>
        </auth-constraint>
    </security-constraint>
    <security-constraint>
        <display-name>Exclude resource paths</display-name>
        <web-resource-collection>
            <web-resource-name>Excluded</web-resource-name>
            <url-pattern>/ui/index.xhtml</url-pattern>
            <url-pattern>/ui/login.xhtml</url-pattern>
            <url-pattern>/resources/*</url-pattern>
            <url-pattern>/jakarta.faces.resource/*</url-pattern>
            <url-pattern>/ui/jakarta.faces.resource/*</url-pattern>
            <!--<url-pattern>/primepush/*</url-pattern>-->
            <!-- ADD ERROR PAGES TO EXCLUSION -->
            <url-pattern>/error-pages/*</url-pattern>
        </web-resource-collection>
    </security-constraint>
    
    <security-constraint>
        <display-name>Enable CORS</display-name>
        <web-resource-collection>
            <web-resource-name>Resources</web-resource-name>
            <url-pattern>/resource/*</url-pattern>
            <http-method>GET</http-method>
            <http-method>PUT</http-method>
            <http-method>POST</http-method>
            <http-method>DELETE</http-method>
            <http-method>TRACE</http-method>
            <http-method>CONNECT</http-method>
            <http-method>HEAD</http-method>
            <!--Do not delete for CORS preflight requests-->
            <!--<http-method>OPTIONS</http-method>-->
        </web-resource-collection>
        <auth-constraint>
            <role-name>signee</role-name>
            <role-name>unitadmin</role-name>
        </auth-constraint>
    </security-constraint>
    
    <!--https://www.primefaces.org/primefaces-el-injection-update/-->
    <security-constraint>
        <display-name>El-injection-CVE</display-name>
        <web-resource-collection>
            <web-resource-name>Site</web-resource-name>
            <url-pattern>/jakarta.faces.resource/dynamiccontent.properties.xhtml</url-pattern>
            <url-pattern>/ui/jakarta.faces.resource/dynamiccontent.properties.xhtml</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>signee</role-name>
            <role-name>unitadmin</role-name>
        </auth-constraint>
    </security-constraint>
    
    <!--    <security-constraint>
        <display-name>WebDav public resources.</display-name>
        <web-resource-collection>
            <web-resource-name>Site</web-resource-name>
            <url-pattern>/dav/public/*</url-pattern>
            <http-method>GET</http-method>
            <http-method>OPTIONS</http-method>
        </web-resource-collection>
    </security-constraint>-->
    <!--    <security-constraint>
        <display-name>WebDav for signees.</display-name>
        <web-resource-collection>
            <web-resource-name>Login Resources</web-resource-name>
            <url-pattern>/dav/signee/*</url-pattern>
            <http-method>GET</http-method>
        </web-resource-collection>
        <auth-constraint>
            <role-name>signee</role-name>
            <role-name>unitadmin</role-name>
        </auth-constraint>
    </security-constraint>-->
    <security-constraint>
        <display-name>WebDav for unitadmins</display-name>
        <web-resource-collection>
            <web-resource-name>Login Resources</web-resource-name>
            <url-pattern>/dav/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>unitadmin</role-name>
        </auth-constraint>
    </security-constraint>
    <!--    <login-config>
        <auth-method>FORM</auth-method>
        <realm-name>${web.module.authentication.realm}</realm-name>
        <form-login-config>
            <form-login-page>/ui/login.xhtml</form-login-page>
            <form-error-page>/userlogin.xhtml</form-error-page>
        </form-login-config>
    </login-config>-->
    <security-role>
        <description>Default logged in user.</description>
        <role-name>signee</role-name>
    </security-role>
    <!-- Error Pages -->
    <!-- 404 Not Found -->
    <error-page>
        <error-code>404</error-code>
        <location>/error-pages/notFound.xhtml</location>
    </error-page>
    <!-- 500 Internal Server Error -->
    <error-page>
        <error-code>500</error-code>
        <location>/error-pages/error.xhtml</location>
    </error-page>
    <!-- General Exception -->
    <error-page>
        <exception-type>java.lang.Exception</exception-type>
        <location>/error-pages/error.xhtml</location>
    </error-page>
    <!-- Throwable (catches everything) -->
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/error-pages/error.xhtml</location>
    </error-page>
</web-app>
