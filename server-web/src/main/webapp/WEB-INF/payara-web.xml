<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE payara-web-app PUBLIC "-//Payara.fish//DTD Payara Server 4 Servlet 3.0//EN" "https://docs.payara.fish/schemas/payara-web-app_4.dtd">
<payara-web-app error-url="">
    <!--httpservlet-security-provider="iserv-imap-auth">-->
    <!--<context-root>/web</context-root>-->
    <context-root>${web.module.context.root}</context-root>
    <!--${com.sun.aas.instanceRoot}-->
    <!--    <property name="alternatedocroot_1" value="from=/dav/* dir=/opt/glassfish-4.1/glassfish/domains/domain1/app-resources/"/>-->
    <security-role-mapping>
        <role-name>signee</role-name>
        <group-name>signees</group-name>
    </security-role-mapping>
    <security-role-mapping>
        <role-name>unitadmin</role-name>
        <group-name>unitadmins</group-name>
    </security-role-mapping>
    <!--https://docs.payara.fish/community/docs/Technical%20Documentation/Application%20Development/Using%20Jakarta%20Faces%20Technology.html-->
<!--    <class-loader delegate="false"/>
    <property name="useBundledJsf" value="true" />-->
    <jsp-config>
        <property name="keepgenerated" value="false">
            <description>Keep a copy of the generated servlet class' java code.</description>
        </property>
    </jsp-config>
</payara-web-app>
